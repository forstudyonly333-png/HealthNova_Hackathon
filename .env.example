# Server port (default 8080 on Cloud Run, 3000 locally)
PORT=

# Gemini Multimodal API Key (optional for synthetic demo evaluation)
GEMINI_API_KEY=

# Public demo mode flag (true for instant evaluation without login)
DEMO_MODE=

# Custom path to SQLite database file
DATABASE_PATH=

# Secret key for AES-256-CBC encryption of patient health info (PHI) at rest
ENCRYPTION_KEY=

# WhatsApp provider ('simulated' or 'cloud')
WHATSAPP_PROVIDER=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=

# Canonical public web service URL
APP_URL=

# Meta WhatsApp Cloud API access token (only needed if WHATSAPP_PROVIDER is cloud)
WHATSAPP_API_TOKEN=

# Meta WhatsApp Business phone number ID (only needed if WHATSAPP_PROVIDER is cloud)
WHATSAPP_PHONE_NUMBER_ID=

# Hospital Reception WhatsApp Number (digits only, e.g. 917374029569)
RECEPTION_WHATSAPP_NUMBER=917374029569

# Hospital Reception Voice Call Number (digits only, e.g. 917374029569)
RECEPTION_CALL_NUMBER=917374029569
